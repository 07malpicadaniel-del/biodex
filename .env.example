# Copiar a .env para desarrollo local. Nunca subir secretos reales a Git.
DATABASE_URL=postgres://biodex:biodex_dev_password@127.0.0.1:5432/biodex
BIND_ADDR=0.0.0.0:3000
MODS_DIR=mods
MAX_MOIRE_SCORE=0.35

# Pipeline de visión taxonómica y normalización (inaturalist | mock)
VISION_PROVIDER=inaturalist
VISION_MIN_CONFIDENCE=0.35
INATURALIST_API_TOKEN=
INATURALIST_TAXA_URL=https://api.inaturalist.org/v1
GBIF_API_URL=https://api.gbif.org/v1
WIKIDATA_API_URL=https://www.wikidata.org/w/api.php

# Ingesta geoespacial desde OpenStreetMap (binario sync-geozones)
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_DEFAULT_BBOX=17.10,-98.70,22.50,-93.60

# Reservado para uso futuro (deshabilitado en Fase 1)
# GOOGLE_AI_API_KEY=

# Respaldo biogeográfico con observaciones de NaturaLista cuando no hay polígono curado en PostGIS
ENABLE_NATURALISTA_RANGE_FALLBACK=true

# Solo para pruebas manuales locales sin token CV
ALLOW_DEV_TAXON_HINT=false
